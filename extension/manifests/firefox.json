{
  "background": {
    "scripts": [
      "compat.js",
      "firefox_capture.js",
      "handback.js",
      "background.js",
      "hls_capture.js",
      "overlay_rules.js",
      "videos.js",
      "savepdf-bg.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bddm-catcher@bddm.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "compat.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "compat.js",
        "overlay_rules.js",
        "overlay.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://drive.google.com/*",
        "https://docs.google.com/*"
      ],
      "js": [
        "compat.js",
        "savepdf.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "webRequestBlocking"
  ]
}
